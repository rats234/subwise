# Copy this file to .env for local development.
# In production, set these as environment variables in your host's dashboard
# instead of committing a .env file.

# Required
SESSION_SECRET=replace-with-a-long-random-string

# Required — a Postgres connection string. Free option: sign up at
# https://neon.tech (no card needed), create a project, copy its connection
# string here. Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Optional — leave unset and the app runs fully in "free tier only" mode
# with no billing and a template-based cancellation email.

# Stripe (for the premium upgrade). Get these from https://dashboard.stripe.com
#  1. Create a product ("SubWise Premium") with a recurring monthly price.
#  2. Copy that price's ID into STRIPE_PRICE_ID (looks like price_123...).
#  3. Copy your secret key into STRIPE_SECRET_KEY (starts sk_test_ or sk_live_).
#  4. Create a webhook endpoint pointing at https://yourdomain.com/api/billing/webhook
#     listening for "checkout.session.completed", then copy its signing
#     secret into STRIPE_WEBHOOK_SECRET (starts whsec_).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Anthropic (for AI-personalized cancellation emails instead of the built-in
# template). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Usually only needed in production
PORT=3000
NODE_ENV=production
