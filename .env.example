# Copy this file to .env for local development.
# In production, set these as environment variables in your host's dashboard
# instead of committing a .env file.

# Required
SESSION_SECRET=replace-with-a-long-random-string

# Required — a Postgres connection string. Free option: sign up at
# https://neon.tech (no card needed), create a project, copy its connection
# string here. Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Optional — leave unset and the app runs fully in "free tier only" mode
# with no billing and a template-based cancellation email.

# Premium is sold on the honor system, not a card form: point PAYPAL_LINK at
# your paypal.me (or Buy Me a Coffee) page, and set UNLOCK_CODE to a secret
# word/phrase. When someone sends a coffee, email them UNLOCK_CODE by hand —
# they paste it into the app's "Redeem code" box to flip is_premium on for
# their account. Rotate UNLOCK_CODE occasionally since it's shared by everyone
# you've told it to (just update the env var — no redeploy of code needed).
PAYPAL_LINK=
UNLOCK_CODE=

# Anthropic (for AI-personalized cancellation emails instead of the built-in
# template). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Usually only needed in production
PORT=3000
NODE_ENV=production
